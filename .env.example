# Copier ce fichier en ".env" et adapter les valeurs. Ne JAMAIS versionner le vrai .env.

# Clé secrète qui signe les cookies de session. Générer une valeur aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changez-moi

# Base de données (SQLite par défaut ; PostgreSQL possible, ex. postgresql+psycopg://user:pass@db/roubil)
DATABASE_URL=sqlite:///./data/roubil.sqlite3

# En production derrière HTTPS : true (le cookie de session n'est alors envoyé qu'en HTTPS)
COOKIE_SECURE=false

# Notification e-mail à chaque message reçu (facultatif : laisser vide pour désactiver)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=CRR0904@gmail.com

# Durée de conservation des messages de contact, en jours (minimisation des données)
RETENTION_DAYS=90
